		var element = "Limit Search to Contents Created Within a Period of Time";

		Blueprints.addElement(element = "${element}");

		Click(locator1 = "//li[contains(.,'From')]//button[contains(@class,'date-picker-dropdown-toggle')]");

		Click(locator1 = "//div[contains(@class,'show')]//button[contains(.,'15')]");

		Click(locator1 = "//li[contains(.,'To')]//button[contains(@class,'date-picker-dropdown-toggle')]");

		Click(locator1 = "//div[contains(@class,'show')]//button[contains(.,'15')]");

		Blueprints.searchBlueprintsPreview(searchTerm = "test");

