<html>
<head>
<title>Blueprints</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Blueprints</td></tr>
</thead>

<tbody>
<tr>
	<td>BLUEPRINTS_ADMIN_ENTRY_TITLE</td>
	<td>//div[contains(@class,'table-list-title')]//*[normalize-space(text())='${title}']</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADMIN_ENTRY_DESCRIPTION</td>
	<td>//div[contains(@class,'dnd-tr')][.//*[normalize-space(text())='${blueprintTitle}']]//div[contains(@class,'dnd-td')][2]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADMIN_ENTRY_VERTICAL_ELLIPSIS</td>
	<td>//*[contains(@class,'dnd-tr') and contains(.,'${title}')]//*[*[name()='svg'][contains(@class,'icon-ellipsis')]]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_EDIT_PAGE_HEADER_TITLE</td>
	<td>//ul[contains(@class,'tbar-nav')]//div[contains(@class,'entry-title')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_EDIT_PAGE_HEADER_DESCRIPTION</td>
	<td>//ul[contains(@class,'tbar-nav')]//div[contains(@class,'entry-description')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_EDIT_PAGE_VIEW_ELEMENT_JSON_TEXT</td>
	<td>//span[contains(@class,'cm-string') and contains(.,'${key_jsonText}')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_HEADER</td>
	<td>//div[contains(@class,'sidebar-header')]//span[contains(.,'Add Query Elements')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_CLEAR</td>
	<td>//div[contains(@class,'add-sxp-element-sidebar')]//button[contains(@title,'Clear')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_SEARCH_BAR</td>
	<td>//div[contains(@class,'add-sxp-element-sidebar')]//input[contains(@placeholder,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_NAME</td>
	<td>//div[contains(@class,'element-list')]//p[contains(.,'${element}') and contains(@class, 'list-group-title')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADD_ELEMENTS_SIDEBAR_ELEMENT_ADD_BUTTON</td>
	<td>//div[contains(@class,'autofit-col') and contains(.,'${element}')]/following-sibling::div/button[contains(.,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT</td>
	<td>//div[contains(@id,'querySXPElement')][./ul[contains(.,'${element}')]]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_VERTICAL_ELLIPSIS</td>
	<td>//div[contains(@id,'querySXPElement')][.//*[contains(.,'${element}')]]//*[contains(@class,'icon-ellipsis')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_JSON_DOWNLOAD_BUTTON</td>
	<td>//a[@download='sxpElement.json']</td>
	<td></td>
</tr>
<tr>
	<td>ELEMENTS_EDIT_PAGE_TEMPLATE_EDITOR</td>
	<td>//div[contains(@class,'element-header') and contains(.,'Element Template (JSON')]/following-sibling::div//div[contains(@class,'CodeMirror cm-s-default')]</td>
	<td></td>
</tr>
<tr>
	<td>ELEMENTS_EDIT_PAGE_UI_CONFIGURATION_EDITOR</td>
	<td>//div[contains(@class,'element-header') and contains(.,'UI Configuration (JSON')]/following-sibling::div//div[contains(@class,'CodeMirror cm-s-default')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_GENERIC_DROPDOWN</td>
	<td>//select[@aria-label="${dropdownName}"]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_GENERIC_DROPDOWN_OPTION</td>
	<td>//select[@aria-label="${dropdownName}"]/option[contains(.,"${option}")]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_ELASTICSEARCH_QUERY_EDITOR</td>
	<td>//div[contains(@class,'custom-json')]//div[contains(@class,'CodeMirror cm-s-default')]</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_NUMBER_FIELD</td>
	<td>//div[contains(.,'${key_fieldLabel}')]//input[@type='number']</td>
	<td></td>
</tr>
<tr>
	<td>BLUEPRINTS_ADDED_ELEMENT_TEXT_FIELD</td>
	<td>//input[contains(@aria-label, "${key_fieldLabel}") and @type='text']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>